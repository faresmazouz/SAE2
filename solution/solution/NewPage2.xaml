<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="solution.RulePage"
             Title="RulePage">
    <VerticalStackLayout Background="#3E3232">
        <Label TextColor="White" HorizontalTextAlignment="Center" Text="Les règles de l'Hexapawn"></Label>
