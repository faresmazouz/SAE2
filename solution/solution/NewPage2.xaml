            <Label  Grid.Column="0" TextColor="White" Text="Hexapawn est un jeu de stratégie simple qui se joue sur un petit plateau de 3 cases par 3 (3x3)."></Label>
            <ImageButton Margin="0,0,15 ,0" Grid.Column="1" Source="arrow.png" WidthRequest="50" Background="Transparent"></ImageButton>
        </Grid>
    </VerticalStackLayout>
</ContentPage>